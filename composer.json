{
    "name": "rapira/sdk-php",
    "description": "Development monorepo for the Rapira SDK; individual packages under packages/* are published separately",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "rapira",
        "sdk",
        "testo",
        "testing",
        "server",
        "worker",
        "plugin"
    ],
    "homepage": "https://github.com/rapira-rs/sdk-php",
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.4",
        "rapira/http": "^0.1.2",
        "rapira/testing": "^0.1.3"
    },
    "require-dev": {
        "buggregator/trap": "^1.16",
        "httpsoft/http-message": "^1.0",
        "infection/infection": "^0.33.2",
        "llm/skills": "^1.9",
        "spiral/code-style": "^2.3.1",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.42",
        "vimeo/psalm": "^7"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "rapira/http": "0.1.x-dev",
                    "rapira/testing": "0.1.x-dev"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Rapira\\Sdk\\Tests\\": [
                "packages/http/tests",
                "packages/testing/tests"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "llm/skills": true
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "infect": "infection --configuration=infection.json --threads=max",
        "infect:ci": [
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0"
        ],
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": [
            "testo"
        ],
        "test:unit": "vendor/bin/testo --suite=\"Http: Unit\""
    }
}
