{
    "name": "rapira/sdk",
    "description": "SDK for building on rapira: shared building blocks, testing utilities, and framework bridges",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "rapira",
        "sdk",
        "testo",
        "testing",
        "server",
        "worker",
        "plugin"
    ],
    "homepage": "https://github.com/rapira-rs/sdk",
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^2.0 || ^3.0",
        "internal/dload": "^1.14",
        "internal/path": "^1.3"
    },
    "require-dev": {
        "buggregator/trap": "^1.16",
        "infection/infection": "^0.33.2",
        "llm/skills": "^1.9",
        "rapira/contract": "@dev",
        "spiral/code-style": "^2.3.1",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.42",
        "vimeo/psalm": "^7"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Rapira\\Sdk": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rapira\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "llm/skills": true
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "infect": "infection --configuration=infection.json --threads=max",
        "infect:ci": [
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0"
        ],
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": [
            "testo"
        ],
        "test:unit": "vendor/bin/testo --suite=Unit"
    }
}
